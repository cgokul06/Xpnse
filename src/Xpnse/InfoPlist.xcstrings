    "NSAppleMusicUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App benötigt Medienzugriff zum Scannen von Rechnungen und Belegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app needs media access to scan bills and receipts for automatic data extraction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app necesita acceso a medios para escanear facturas y recibos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app a besoin d'accéder aux médias pour scanner factures et reçus."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapLedger nutzt die Kamera, damit Sie Rechnungen und Belege fotografieren und beim Hinzufügen einer Transaktion Betrag, Händler, Datum und Kategorie automatisch ausfüllen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapLedger uses the camera so you can photograph bills and receipts and automatically fill in amount, merchant, date, and category when adding a transaction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapLedger usa la cámara para que puedas fotografiar facturas y recibos y completar automáticamente el importe, el comercio, la fecha y la categoría al añadir una transacción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SnapLedger utilise l'appareil photo pour photographier factures et reçus et remplir automatiquement le montant, le commerçant, la date et la catégorie lors de l'ajout d'une transaction."
          }
        }
      }
    },
