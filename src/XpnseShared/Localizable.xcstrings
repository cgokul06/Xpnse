    "txn.reminder_invalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erinnerung muss vor dem Transaktionsdatum liegen, spätestens am Ende des Vortags (z. B. Transaktion 11. Mai → Erinnerung am 10. Mai bis 23:59)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminder must be before the transaction date, at latest the end of the previous day (e.g. transaction 11 May → reminder on or before 10 May, 11:59 p.m.)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El recordatorio debe ser antes de la fecha de la transacción, como máximo al final del día anterior (p. ej. transacción el 11 de mayo → recordatorio el 10 de mayo a las 23:59 o antes)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rappel doit être avant la date de la transaction, au plus tard à la fin de la veille (p. ex. transaction le 11 mai → rappel le 10 mai à 23:59 au plus tard)."
          }
        }
      }
    },
    "txn.reminder_invalid_start" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erinnerung muss vor dem Startdatum liegen, spätestens am Ende des Vortags (z. B. Start 11. Mai → Erinnerung am 10. Mai bis 23:59)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reminder must be before the start date, at latest the end of the previous day (e.g. start 11 May → reminder on or before 10 May, 11:59 p.m.)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El recordatorio debe ser antes de la fecha de inicio, como máximo al final del día anterior (p. ej. inicio el 11 de mayo → recordatorio el 10 de mayo a las 23:59 o antes)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rappel doit être avant la date de début, au plus tard à la fin de la veille (p. ex. début le 11 mai → rappel le 10 mai à 23:59 au plus tard)."
          }
        }
      }
    },
